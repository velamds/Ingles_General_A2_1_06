{"_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "John in Brazil"}, {"type": "unit_name", "content": "Natural Wonders of Brazil"}, {"type": "position", "content": 11}, {"type": "origin", "content": "scholar > Nature Around Us > Rainforest"}, {"type": "lesson", "content": 6}, {"type": "level", "content": "A2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": " Accurately use information about travel and vacations in social situations."}, {"type": "secondary_1", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_2", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_3", "content": " Identifies general information in short written or spoken conversations."}, {"type": "secondary_4", "content": "Gives appropriate directions to places taking into account the type of interlocutor."}, {"type": "secondary_5", "content": "Gives appropriate directions to places taking into account the type of interlocutor."}, {"type": "secondary_6", "content": "Gives appropriate directions to places taking into account the type of interlocutor."}, {"type": "secondary_7", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_8", "content": "Identifies general information in short written or spoken conversations."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Present Continuous Tense  vs.  the Present Simple Tense"}, {"type": "describer", "content": " "}, {"type": "text", "content": "You use the Present Continuous tense to talk about:"}, {"type": "text", "content": "<ul>  \t<li>things in general </li> \t<li>things that happen regularly </li> \t<li>things that do not change</li></ul>   \t\t\t"}, {"type": "text", "content": "Form: subject + verb "}, {"type": "text", "content": "You use the Present Continuous tense to talk about:"}, {"type": "text", "content": "<ul>  \t<li>something that is happening now </li> \t<li>something that is happening around now (today) plans </li>  </ul>   \t\t\t"}, {"type": "text", "content": "Form : subject + to be + verb+ing"}, {"type": "table", "content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"strong\\\"> Present Simple </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"strong\\\">Present Continuous</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I like cookies!<br /> He always wins that game!<br /> She enjoys dancing.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">She's eating a cookie.<br /> He isn't winning today.<br /> They are dancing in the parade.</span>\\\"}\"],\"styles\":\" instruction_table_background\"}"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " The Zero Conditional"}, {"type": "describer", "content": "You use the zero conditional to talk about general truths."}, {"type": "example", "content": "If this continues, the rainforest may disappear soon."}, {"type": "text", "content": "There are two parts to the sentence. "}, {"type": "text", "content": "One part is the condition. The other part is the result."}, {"type": "text", "content": " From:<br />If + the Simple Present tense, the Simple Present Tense<br /> <span class=\"italic\">If I have time, I go to the cinema.</span>"}, {"type": "text", "content": "The condition is  <span class=\"italic\">have time</span>.  The result is go to the <span class=\"italic\">cinema</span>."}, {"type": "table", "content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"strong\\\"> Condition </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"strong\\\"> Result </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">If you want to see the rainforest up close,<br /><br />  If you like trees and flowers,</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">go with a group. <br /><br />  the rainforest is the place to visit!</span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}, {"type": "example", "content": " If too many trees are cut down, deserts can form. "}, {"type": "example", "content": "If you want to help, have a rainforest night."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "Carnival "}, {"type": "definition", "content": "a celebration in many countries "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I go to Brazil for Carnival every year!"}, {"type": "audio", "content": "engenn4le06ob11aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you need to review."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "parade "}, {"type": "definition", "content": "a special event when people walk or ride  n the same direction "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: There are thousands of people in the Carnival parade."}, {"type": "audio", "content": "engenn4le06ob11aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "samba "}, {"type": "definition", "content": "a dance from Brazil "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Everyone dances the samba at this club."}, {"type": "audio", "content": "engenn4le06ob11aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "spectacular "}, {"type": "definition", "content": "exciting and interesting "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "