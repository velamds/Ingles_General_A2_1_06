target_word", "contents": [{"content": "groove", "type": "name"}, {"content": "a long narrow cut", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: He cuts a deep groove into the tree.", "type": "example"}, {"content": "engenn4le06ob09aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "bark", "type": "name"}, {"content": "the outside of a tree", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The tree bark is rough and hard.", "type": "example"}, {"content": "engenn4le06ob09aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "rubber", "type": "name"}, {"content": "an elastic waterproof substance ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Her rubber boots keep her dry in the rain.", "type": "example"}, {"content": "engenn4le06ob09aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to flow", "type": "name"}, {"content": "to move like water ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Rubber sap flows out of the tree.", "type": "example"}, {"content": "engenn4le06ob09aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "easily ", "type": "name"}, {"content": "without difficulty ", "type": "definition"}, {"content": "(adverb)", "type": "part_speech"}, {"content": "Example: Sap comes out easily.", "type": "example"}, {"content": "engenn4le06ob09aud07", "type": "audio"}]}, {"content": "engenn4le06ob09re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "The Simple Present Tense", "type": "heading"}, {"content": "You use the <span class=\"strong\">Simple Present</span> tense to talk about habits and routines.<br />These are things that you do frequently or every day.", "type": "describer"}, {"content": "I cut grooves into the bark to let the latex flow. ", "type": "example"}, {"content": "I tap the trees to get the latex.", "type": "example"}]}, {"type": "takeaway_extension", "contents": [{"content": "Look on the Internet for an interesting job.", "type": "text"}, {"content": "Find out what the person does in their job.", "type": "text"}, {"content": "Write 30 to 40 words.", "type": "text"}, {"content": "Use infinitives of purpose.", "type": "text"}, {"content": "Use the Simple Present tense for routines.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I do research on an interesting job. ", "type": "text"}, {"content": "I write about what a person does at that job.", "type": "text"}, {"content": "I express purpose in connection with the job.", "type": "text"}, {"content": "I describe the job routines.", "type": "text"}]}], "labs": [{"stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "id": 0, "template_override": 1}, {"id": 1, "contents": [{"value": {"audiosrc": "engenn4le06ob09re2aud01", "images": [{"image": "engenn4le06ob09re2img01.jpg", "id": 0, "text": "", "time": "0"}, {"image": "engenn4le06ob09re2img01.jpg", "id": 1, "text": "<span class=\"strong\">Miguel</span>: I'm a rubber tapper. I tap trees in the rainforest. My day begins early. I tap the trees to get the latex, or natural rubber. It flows freely in the cool morning air.<br>\n<span class=\"strong\">John</span>: How do you collect the latex?", "time": "100"}, {"image": "engenn4le06ob09re2img02.jpg", "id": 2, "text": "<span class=\"strong\">Miguel</span>: I cut grooves into the bark to let the latex flow. Then, I attach a small cup to the tree to catch it. I tap 350 trees a day.<br>\n<span class=\"strong\">John</span>: Do many people tap trees?<br>\n<span class=\"strong\">Miguel</span>: No, not many people tap trees now. The rainforest is disappearing. The number of rubber trees is small. My children go to school to learn other skills.", "time": "16000"}, {"image": "engenn4le06ob09re2img02.jpg", "id": 3, "text": "<span class=\"strong\">John</span>: I would love to go to watch you tap trees. <br>\n<span class=\"strong\">Miguel</span>: I enjoy taking people into the forest to see where I work.<br>\n<span class=\"strong\">John</span>: That sounds wonderful.", "time": "42300"}], "coverimg": "engenn4le06ob09re2img01.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "title": ""}], "exercises": [{"id": 0, "template_override": 1, "stimuli_ids": [0], "img_path": "", "type": "WLC", "_data": [{"type": "instructions", "contents": [{"content": "I can talk about ecological issues.", "type": "Learning Outcomes"}, {"content": "I can express a goal or a purpose.", "type": "Learning Outcomes"}, {"content": "I can talk about routine activities.", "type": "Learning Outcomes"}, {"content": "What unusual jobs can you think of?", "type": "Free Header Item"}, {"content": "What do the people who have these jobs do every day?", "type": "Free Header Item"}]}, {"type": "group", "contents": [{"content": "Welcome", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct", "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "What does a rubber tapper do?", "type": "free_type_text_area"}], "questions": []}, {"id": 1, "template_override": 1, "stimuli_ids": [1], "_data": [{"type": "instructions", "contents": [{"content": "John is visiting a rubber plantation while he's on holiday in Brazil!<br /> Rubber tappers have unusual <span class=\"tool-tip\" id=\"tip_1_0\">skills</span>!", "type": "text"}]}, {"type": "group", "contents": [{"content": "Content", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "