"}, {"image": "engenn4le06ob07re2img03.jpg", "id": 4, "text": "If you sign up with Amazon Orientation, you are part of our campaign.  A portion of your fee goes towards protecting the rainforest!", "time": "39000"}], "coverimg": "engenn4le06ob07re2img01.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "title": ""}], "id": 0, "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}]}