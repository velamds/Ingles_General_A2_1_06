"type": "rec"}]}, {"content": "secondary_3", "type": "objective"}], "id": 4, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}]}]}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "id": 0, "template_override": 1}, {"id": 1, "contents": [{"value": {"audiosrc": "engenn4le06ob05re2aud01", "images": [{"image": "engenn4le06ob05re2img05.jpg", "id": 0, "text": "", "time": "0"}, {"image": "engenn4le06ob05re2img05.jpg", "id": 1, "text": "<span class=\"strong\">John</span>:  Tell me about the rainforest,  Hannah. Is there a trip you recommend?<br>\n<span class=\"strong\">Hannah</span>: If you want to see the rainforest, sign up for the Amazon Orientation.<br>\n<span class=\"strong\">John</span>: Oh? Why?<br>\n<span class=\"strong\">Hannah</span>: Well, if you want to see the rainforest up close, go with a group.<br>", "time": "100"}, {"image": "engenn4le06ob05re2img01.jpg", "id": 2, "text": "<span class=\"strong\">John</span>: Where do you go?<br>\n<span class=\"strong\">Hannah</span>: You go up into the forest. Then you go south, away from the equator.<br>\n<span class=\"strong\">John</span>: The equator?<br>\n<span class=\"strong\">Hannah</span>: The Amazon River is below the equator. So, you hike toward the south.<br>", "time": "16000"}, {"image": "engenn4le06ob05re2img02.jpg", "id": 3, "text": "<span class=\"strong\">John</span>: Where's the camp? <br>\n<span class=\"strong\">Hannah</span>: It's on top of a hill. It's high above the trees. <br>\n<span class=\"strong\">John</span>: It sounds amazing!<br>\n<span class=\"strong\">Hannah</span>: If I have time, I go with the group. There is nothing like it. There are so many trees and flowers!<br>\n<span class=\"strong\">John</span>: If you can go on the next tour, let me know!<br>", "time": "29400"}], "coverimg": "engenn4le06ob05re2img05.jpg"}, "type": "slideshow"}], "template_ove