{"labs": [{"stimuli": [{"_data": [], "id": 0, "type": "welcome", "template_override": 1, "contents": [{}]}, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn4le06ob08re2aud01", "coverimg": "engenn4le06ob08re2img04.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn4le06ob08re2img04.jpg"}, {"text": "<span class=\"strong\">Staff member</span>: Jim, I would like you to meet our tour group. Why don't you tell them about your project?<br>\n<span class=\"strong\">Jim</span>: Yes, I'd like to. We made changes to our lifestyle because of the negative impact of deforestation.<br>\n<span class=\"strong\">Staff member</span>: Are you saying that due to the cutting down of trees in your area, your community changed their way of life?<br>", "id": 1, "time": "100", "image": "engenn4le06ob08re2img04.jpg"}, {"text": "<span class=\"strong\">Jim</span>: Exactly. We had a lot of animals, but since many areas turned to desert, we cannot feed them anymore.", "id": 2, "time": "21500", "image": "engenn4le06ob08re2img01.jpg"}, {"text": "<span class=\"strong\">Staff member</span>: Tell us about the project, Jim.<br>\n<span class=\"strong\">Jim</span>: We knew that rainforest plants were good for our skin and hair. We decided to create our own products and sell them to the public.<br>", "id": 3, "time": "30000", "image": "engenn4le06ob08re2img05.jpg"}, {"text": "<span class=\"strong\">Staff member</span>: What a fantastic idea! <br>\n<span class=\"strong\">Jim</span>: Our products are all natural, with no chemicals or artificial ingredients. Plus, they have an exotic smell. <br>\n<span class=\"strong\">Staff</span>: How many products do you carry?<br>\n<span class=\"strong\">Jim</span>: We currently have four - shampoo, conditioner, soap and face cream.<br>", "id": 4, "time": "42000", "image": "engenn4le06ob08re2img03.jpg"}, {"text": "<span class=\"strong\">Staff member</span>: Your community now has a bright future.<br>\n<span class=\"strong\">Jim</span>: We do. How about your group stops by our warehouse tomorrow? We are sending out a big shipment.<br>\n<span class=\"strong\">Staff member</span>: We'd love to. Thanks for the invitation.<br>", "id": 5, "time": "62000", "image": "engenn4le06ob08re2img04.jpg"}]}}]}, {"id": 2, "type": "video", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "video", "value": {"video_src": "engenn4le06ob08re3vid01", "images": [{"text": "", "id": 0, "time": "0", "image": ""}, {"text": "<span class = \"bullet\"</span>What is cause and effect?</span>", "id": 1, "time": "5000", "image": ""}, {"text": "<span class = \"bullet\">Example sentences that use conjunctions</span>", "id": 2, "time": "18000", "image": ""}, {"text": "<span class = \"bullet\">Things to remember</span>", "id": 3, "time": "92000", "image": ""}]}}]}], "exercises": [{"questions": [], "stimuli_ids": [0], "id": 0, "type": "WLC", "img_path": "", "_data": [{"type": "instructions", "contents": [{"type": "skill", "content": "Listening"}, {"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Vocabulary and Grammar"}, {"type": "Learning Outcomes", "content": "I can write about ecological issues."}, {"type": "Learning Outcomes", "content": " I can write about causes, effects and solutions."}, {"type": "Learning Outcomes", "content": "I can ask and respond to suggestions."}, {"type": "Free Header Item", "content": "What kind of shampoo, conditioner and soap do you use?"}, {"type": "Free Header Item", "content": "Is it important for them to have natural ingredients? Why or Why not?"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Welcome"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct", "attempt_feedback": [{"type": "text", "content": "You have 2 tries"}, {"type": "text", "content": "you have 1 attempt left"}], "incorrect_feedback": [{"type": "text", "content