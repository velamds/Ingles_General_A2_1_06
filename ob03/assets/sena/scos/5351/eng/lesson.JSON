io"}], "type": "target_word"}, {"contents": [{"content": " These are words you use to talk about a parade.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "wild ", "type": "name"}, {"content": "unusual; uncontrolled ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Carnival is a wild celebration!", "type": "example"}, {"content": "engenn4le06ob03aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "in addition ", "type": "name"}, {"content": "something extra ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: In addition to being in the parade, you get a costume to wear!", "type": "example"}, {"content": "engenn4le06ob03aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to guarantee ", "type": "name"}, {"content": "to give a promise", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: We guarantee you a place in the parade!", "type": "example"}, {"content": "engenn4le06ob03aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "float ", "type": "name"}, {"content": "a vehicle decorated for a parade ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: You can walk or ride on a float.", "type": "example"}, {"content": "engenn4le06ob03aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "each ", "type": "name"}, {"content": "every one   ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: There are free dance lessons with each booking.", "type": "example"}, {"content": "engenn4le06ob03aud06", "type": "audio"}], "type": "target_word"}, {"content": "engenn4le06ob03re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Find English advertisements.", "type": "text"}, {"content": "Find 3 examples of commands in 